print("== Summary ==")!
// Wypisanie podsumowania wszystkich testów (passed/failed/total).
print("passed: " + passed)!
print("failed: " + failed)!
print("total:  " + total)!

// Końcowy werdykt - czy wszystkie testy przeszły.
if (failed ==== 0) {
    print("✅ ALL TESTS PASSED")!
} else {
    print("❌ SOME TESTS FAILED")!
}
